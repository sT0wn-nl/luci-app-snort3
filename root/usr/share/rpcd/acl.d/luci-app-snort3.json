{
	"luci-app-snort3": {
		"description": "Grant access to LuCI app for Snort IDS",
		"read": {
			"ubus": {
				"luci.snort": [ "getStatus", "getInfo", "getAlerts", "getStats", "lookupRule", "getSyslog", "jobStatus", "printConfig", "getLocalRules", "getPerf", "getCategories" ],
				"luci-rpc": [ "getNetworkDevices" ],
				"network.interface": [ "dump" ]
			},
			"uci": [ "snort", "network" ]
		},
		"write": {
			"ubus": {
				"luci.snort": [ "clearAlerts", "serviceAction", "jobStart", "setLocalRules" ]
			},
			"uci": [ "snort" ]
		}
	}
}
