{%
// SPDX-License-Identifier: Apache-2.0
//
// Included at the end of the generated snort.lua by snort-mgr, via the
// 'snort.snort.include' option which luci-app-snort points here.
// Everything below is driven by the 'luci' section and the 'suppress',
// 'event_filter' and 'rate_filter' sections of /etc/config/snort.

let uci   = require('uci').cursor();
let fs    = require('fs');
let luci  = uci.get_all('snort', 'luci') ?? {};
let local = luci.local_rules ?? '/etc/snort/local.rules';
let cdir  = rtrim(snort.config_dir, '/');

const on   = (v, def) => ((v ?? def) == '1');
const num  = (v, def, min, max) => {
	let n = match(v ?? '', /^[0-9]+$/) ? int(v) : def;
	return (n < min) ? min : (n > max ? max : n);
};
const ip_ok = (v) => match(v ?? '', /^[][0-9A-Za-z:.\/!, $_]+$/) != null;
const note  = (v) => replace(v ?? '', /[\r\n]/g, ' ');
const list  = (v) => (type(v) == 'array') ? v : (v ? [ v ] : []);

function has_rules(path) {
	let fd = fs.open(path, 'r');
	if (!fd) return false;
	let found = false;
	for (let line = fd.read('line'); length(line); line = fd.read('line')) {
		if (match(line, /^\s*[a-z]+\s/) && !match(line, /^\s*#/)) { found = true; break; }
	}
	fd.close();
	return found;
}

/* --- rule states: disabled SIDs and categories ---------------------------- */
let disabled = {};
for (let gs in list(luci.disabled_sid)) {
	let m = match(gs, /^([0-9]+):([0-9]+)$/) ?? match(gs, /^()([0-9]+)$/);
	if (m) disabled[`${m[1] || 1}:${m[2]}`] = true;
}
let cats = {};
for (let c in list(luci.disabled_category))
	if (match(c, /^[A-Za-z0-9_-]+$/)) cats[c] = true;

if (length(keys(cats))) {
	for (let f in (fs.glob(`${cdir}/rules/*.rules`) ?? [])) {
		let fd = fs.open(f, 'r');
		if (!fd) continue;
		for (let line = fd.read('line'); length(line); line = fd.read('line')) {
			if (match(line, /^\s*#/)) continue;
			let m = match(line, /msg:\s*"([A-Za-z0-9_-]+) /);
			if (!m || !cats[m[1]]) continue;
			let sid = match(line, /[^a-z]sid:\s*([0-9]+)/);
			let gid = match(line, /[^a-z]gid:\s*([0-9]+)/);
			if (sid) disabled[`${gid ? gid[1] : 1}:${sid[1]}`] = true;
		}
		fd.close();
	}
}

/* --- suppressions, event filters, rate filters ----------------------------- */
let sups = [], efs = [], rfs = [];
uci.foreach('snort', 'suppress', (s) => {
	if (s.enabled == '0' || !match(s.sid ?? '', /^[0-9]+$/)) return;
	push(sups, {
		gid: num(s.gid, 1, 0, 8129), sid: int(s.sid),
		track: (s.track in [ 'by_src', 'by_dst' ] && ip_ok(s.ip)) ? s.track : null,
		ip: s.ip, note: note(s.comment)
	});
});
uci.foreach('snort', 'event_filter', (s) => {
	if (s.enabled == '0' || !match(s.sid ?? '', /^[0-9]+$/)) return;
	push(efs, {
		gid: num(s.gid, 1, 0, 8129), sid: int(s.sid),
		type: (s.type in [ 'limit', 'threshold', 'both' ]) ? s.type : 'limit',
		track: (s.track in [ 'by_src', 'by_dst' ]) ? s.track : 'by_src',
		count: num(s.count, 1, 0, 2147483647), seconds: num(s.seconds, 60, 0, 2147483647),
		ip: ip_ok(s.ip) ? s.ip : null, note: note(s.comment)
	});
});
uci.foreach('snort', 'rate_filter', (s) => {
	if (s.enabled == '0' || !match(s.sid ?? '', /^[0-9]+$/)) return;
	push(rfs, {
		gid: num(s.gid, 1, 0, 8129), sid: int(s.sid),
		track: (s.track in [ 'by_src', 'by_dst', 'by_rule' ]) ? s.track : 'by_src',
		count: num(s.count, 10, 0, 2147483647), seconds: num(s.seconds, 60, 0, 2147483647),
		timeout: num(s.timeout, 300, 0, 2147483647),
		new_action: (s.new_action in [ 'alert', 'block', 'drop', 'reject', 'pass', 'log' ]) ? s.new_action : 'drop',
		apply_to: ip_ok(s.apply_to) ? s.apply_to : null, note: note(s.comment)
	});
});

/* --- reputation lists ------------------------------------------------------ */
let rep = on(luci.reputation, '0');
let rep_block = null, rep_allow = null;
if (rep) {
	let manual = filter(list(luci.reputation_block), (v) => match(v, /^[0-9A-Fa-f:.\/]+$/));
	let file   = luci.reputation_blocklist;
	if (length(manual) || (file && fs.access(file))) {
		rep_block = `${snort.temp_dir}/luci-blocklist.txt`;
		let content = '# generated by luci-app-snort\n' + join('\n', manual) + '\n';
		if (file && fs.access(file))
			content += fs.readfile(file) ?? '';
		fs.writefile(rep_block, content);
	}
	let amanual = filter(list(luci.reputation_allow), (v) => match(v, /^[0-9A-Fa-f:.\/]+$/));
	if (length(amanual)) {
		rep_allow = `${snort.temp_dir}/luci-allowlist.txt`;
		fs.writefile(rep_allow, '# generated by luci-app-snort\n' + join('\n', amanual) + '\n');
	}
	if (!rep_block && !rep_allow) rep = false;
}

let policy   = luci.policy;
let pscan    = on(luci.portscan, '0');
let builtin  = on(luci.builtin_rules, '0');
let level    = (luci.portscan_level in [ 'low', 'med', 'hi' ]) ? luci.portscan_level : 'med';
let stubs    = [];
if (!builtin) {
	if (pscan)
		for (let i = 1; i <= 27; i++)
			push(stubs, `alert ( gid:122; sid:${i}; rev:1; msg:"(port_scan) builtin ${i}"; )`);
	if (rep)
		for (let i in [ 1, 4 ])
			push(stubs, `alert ( gid:136; sid:${i}; rev:1; msg:"(reputation) builtin ${i}"; )`);
}
-%}
-- luci-app-snort: settings, custom rules, rule states and filters (managed via LuCI)
{% if (policy in [ 'connectivity', 'balanced', 'security', 'max_detect' ] && fs.access(`${cdir}/${policy}.lua`)): %}
include('{{ cdir }}/{{ policy }}.lua')   -- detection policy
{% endif %}
{% if (pscan): %}
port_scan = default_{{ level }}_port_scan
{%   let ign = filter(list(luci.portscan_ignore), ip_ok); if (length(ign)): %}
port_scan.ignore_scanners = '{{ join(' ', ign) }}'
{%   endif %}
{% else %}
port_scan = nil
{% endif %}
{% if (builtin): %}
ips.enable_builtin_rules = true
{% endif %}
{% if (length(stubs)): %}
ips.rules = (ips.rules or '') .. [[
{{ join('\n', stubs) }}
]]
{% endif %}
{% if (luci.local_rules_enabled != '0' && has_rules(local)): %}
ips.include = '{{ local }}'
{% endif %}
{% if (length(keys(disabled))): %}
ips.states = [[
{%   for (let k in sort(keys(disabled))): let p = split(k, ':'); %}
alert ( gid:{{ p[0] }}; sid:{{ p[1] }}; enable:no; )
{%   endfor %}
]]
{% endif %}
{% if (rep): %}
reputation =
{
{%   if (rep_block): %}
  blocklist = '{{ rep_block }}',
{%   endif %}
{%   if (rep_allow): %}
  allowlist = '{{ rep_allow }}',
{%   endif %}
  scan_local = {{ on(luci.reputation_scan_local, '0') ? 'true' : 'false' }},
}
{% endif %}
{% if (length(sups)): %}
suppress =
{
{%   for (let s in sups): %}
  { gid = {{ s.gid }}, sid = {{ s.sid }}{% if (s.track): %}, track = '{{ s.track }}', ip = '{{ s.ip }}'{% endif %} },{% if (s.note): %} -- {{ s.note }}{% endif %}

{%   endfor %}
}
{% endif %}
{% if (length(efs)): %}
event_filter =
{
{%   for (let e in efs): %}
  { gid = {{ e.gid }}, sid = {{ e.sid }}, type = '{{ e.type }}', track = '{{ e.track }}', count = {{ e.count }}, seconds = {{ e.seconds }}{% if (e.ip): %}, ip = '{{ e.ip }}'{% endif %} },{% if (e.note): %} -- {{ e.note }}{% endif %}

{%   endfor %}
}
{% endif %}
{% if (length(rfs)): %}
rate_filter =
{
{%   for (let r in rfs): %}
  { gid = {{ r.gid }}, sid = {{ r.sid }}, track = '{{ r.track }}', count = {{ r.count }}, seconds = {{ r.seconds }}, timeout = {{ r.timeout }}, new_action = '{{ r.new_action }}'{% if (r.apply_to): %}, apply_to = '{{ r.apply_to }}'{% endif %} },{% if (r.note): %} -- {{ r.note }}{% endif %}

{%   endfor %}
}
{% endif %}
{% if (!on(luci.checksum_eval, '1')): %}
network = network or { }
network.checksum_eval = 'none'
{% endif %}
{% if (on(luci.latency_suspend, '0')): %}
latency = { rule = { max_time = {{ num(luci.latency_rule_max, 500, 50, 1000000) }}, suspend = true, suspend_threshold = 5, max_suspend_time = 30000 } }
{% endif %}
if alert_json then
  alert_json.fields = alert_json.fields .. ' class priority service seconds'
  alert_json.limit = {{ num(luci.alert_limit, 10, 0, 1024) }}
end
{% if (on(luci.perfmon, '1') && int(snort.logging)): %}
perf_monitor = { base = true, cpu = true, seconds = {{ num(luci.perfmon_interval, 60, 10, 3600) }}, packets = 0, format = 'json', max_file_size = 1048576 }
{% endif %}
{%
if (luci.user_include && fs.access(luci.user_include)) {
	printf("-- Include from '%s'\n", luci.user_include);
	include(luci.user_include, { snort, nfq });
}
-%}
